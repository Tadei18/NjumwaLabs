---
import { Icon } from "astro-icon/components";
import { credentialGroups, verificationUrl, credentialsHeadline } from "@data/credentials";

interface Props {
  /** Dark band (home / D365) vs light (About). */
  variant?: "dark" | "light";
  heading?: string;
  eyebrow?: string;
}
const {
  variant = "dark",
  heading = credentialsHeadline,
  eyebrow = "Verified credentials",
} = Astro.props;

const groupIcon: Record<string, string> = {
  expert: "award",
  associate: "badge-check",
  ai: "brain-circuit",
};
---

<div class:list={["creds", variant]}>
  <div class="creds-head" data-reveal>
    <span class="eyebrow">{eyebrow}</span>
    <h2 class="creds-title">{heading}</h2>
  </div>

  <div class="creds-groups stage">
    {
      credentialGroups.map((g, gi) => (
        <div class="creds-group tilt" data-tilt="4" data-reveal="3d" data-delay={String(gi + 1)}>
          <p class="creds-group-label depth-1">
            <Icon name={`lucide:${groupIcon[g.id] ?? "badge-check"}`} />
            {g.label}
            <span class="creds-count">{g.items.length}</span>
          </p>
          <ul class="creds-list depth-1">
            {g.items.map((c) => (
              <li class="creds-chip">
                <Icon name={g.id === "expert" ? "lucide:award" : "lucide:badge-check"} />
                <span>{c.short}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  {
    verificationUrl && (
      <a href={verificationUrl} target="_blank" rel="noopener" class="creds-verify" data-reveal>
        Verify credentials
        <Icon name="lucide:external-link" />
      </a>
    )
  }
</div>

<style>
  .creds-head {
    margin-bottom: 2rem;
    max-width: 42ch;
  }
  .creds-title {
    margin-top: 0.6rem;
    font-size: clamp(1.5rem, 3.2vw, 2.25rem);
  }
  .creds-groups {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .creds-group {
    padding: 1.5rem;
    border-radius: var(--radius-card);
    border: 1px solid var(--glass-edge);
    background:
      linear-gradient(
        155deg,
        rgba(255, 255, 255, 0.6),
        rgba(255, 255, 255, 0.14) 48%,
        rgba(255, 255, 255, 0.4)
      ),
      var(--color-surface);
    box-shadow: var(--shadow-soft);
    transition:
      transform 0.5s var(--ease-glide),
      box-shadow 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out);
  }
  /* `transform` is the pointer tilt's; hover only deepens the cast shadow. */
  .creds-group:hover {
    box-shadow: var(--shadow-float);
    border-color: color-mix(in srgb, var(--color-accent) 40%, var(--glass-edge));
  }
  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .creds-group {
      -webkit-backdrop-filter: blur(var(--glass-blur-sm)) saturate(var(--glass-saturate));
      backdrop-filter: blur(var(--glass-blur-sm)) saturate(var(--glass-saturate));
    }
  }
  .creds-group-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    margin-bottom: 1rem;
  }
  .creds-group-label svg {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-accent-ink);
  }
  .creds-count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
    color: var(--color-accent-ink);
  }
  .creds-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .creds-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    padding: 0.4rem 0.7rem 0.4rem 0.55rem;
    border-radius: 10px;
    background: linear-gradient(180deg, var(--color-surface), var(--color-surface-2));
    border: 1px solid var(--color-line);
    color: var(--color-ink-soft);
    line-height: 1.2;
    transition:
      border-color 0.18s,
      transform 0.18s var(--ease-out);
  }
  .creds-chip:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--color-accent) 50%, var(--color-line));
  }
  .creds-chip svg {
    width: 0.95rem;
    height: 0.95rem;
    flex-shrink: 0;
    color: var(--color-accent-ink);
  }
  .creds-verify {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.75rem;
    padding: 0.7rem 1.2rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-line);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--color-accent-ink);
    transition:
      border-color 0.18s,
      transform 0.18s var(--ease-out);
  }
  .creds-verify:hover {
    transform: translateY(-1px);
    border-color: var(--color-accent);
  }
  .creds-verify svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  /* Dark variant overrides */
  .creds.dark .creds-group {
    background: linear-gradient(
      150deg,
      rgba(255, 255, 255, 0.13),
      rgba(255, 255, 255, 0.02) 46%,
      rgba(255, 255, 255, 0.07)
    );
    border-color: var(--glass-edge-dark);
    box-shadow:
      0 26px 60px -22px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }
  .creds.dark .creds-group:hover {
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
  }
  .creds.dark .creds-group-label svg {
    color: var(--color-accent);
  }
  .creds.dark .creds-count {
    color: var(--color-accent);
  }
  .creds.dark .creds-chip {
    background: rgba(255, 255, 255, 0.05);
    border-color: var(--color-night-line);
    color: rgba(255, 255, 255, 0.82);
  }
  .creds.dark .creds-chip svg {
    color: var(--color-accent);
  }
  .creds.dark .creds-verify {
    color: var(--color-accent);
  }

  @media (min-width: 800px) {
    .creds-groups {
      grid-template-columns: repeat(3, 1fr);
      align-items: start;
    }
  }
</style>
