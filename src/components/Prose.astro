---
// Styled wrapper for MDX content (blog + case studies).
---

<div class="prose">
  <slot />
</div>

<style is:global>
  .prose {
    max-width: 68ch;
    color: var(--color-ink-soft);
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .prose > * + * {
    margin-top: 1.15rem;
  }
  .prose h2 {
    font-size: 1.6rem;
    margin-top: 2.5rem;
    scroll-margin-top: 6rem;
  }
  .prose h3 {
    font-size: 1.25rem;
    margin-top: 2rem;
    scroll-margin-top: 6rem;
  }
  /* h4/h5 previously had no rule at all, so they inherited the body size and
     then shrank further wherever their content was inline code — which in an
     API reference is every endpoint signature, i.e. the document's primary
     navigation rendering smaller than its prose. */
  .prose h4 {
    font-size: 1.12rem;
    margin-top: 2rem;
    scroll-margin-top: 6rem;
  }
  .prose h5 {
    font-size: 1rem;
    margin-top: 1.75rem;
    color: var(--color-ink);
    scroll-margin-top: 6rem;
  }
  .prose h2 + p,
  .prose h3 + p,
  .prose h4 + p,
  .prose h5 + p {
    margin-top: 0.75rem;
  }
  /* An endpoint signature is a heading that happens to be monospace: keep the
     heading's scale and weight rather than dropping to body-code size. */
  .prose :is(h2, h3, h4, h5) code {
    font-size: 0.95em;
    font-weight: 600;
    color: var(--color-accent-ink);
    background: color-mix(in srgb, var(--color-accent) 11%, var(--color-surface-2));
  }
  .prose a {
    color: var(--color-accent-ink);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose strong {
    color: var(--color-ink);
    font-weight: 650;
  }
  .prose ul,
  .prose ol {
    padding-left: 1.4rem;
  }
  .prose li + li {
    margin-top: 0.4rem;
  }
  .prose blockquote {
    border-left: 3px solid var(--color-accent);
    padding-left: 1.1rem;
    color: var(--color-muted);
    font-style: italic;
  }
  .prose code {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--color-surface-2);
    padding: 0.15em 0.4em;
    border-radius: 5px;
  }
  .prose pre {
    background: var(--color-night);
    color: #e6edf3;
    padding: 1.1rem 1.25rem;
    border-radius: 12px;
    overflow-x: auto;
    font-size: 0.9rem;
  }
  .prose pre code {
    background: none;
    padding: 0;
  }
  .prose img {
    border-radius: 12px;
    border: 1px solid var(--color-line);
  }
  .prose hr {
    border: none;
    border-top: 1px solid var(--color-line);
    margin-block: 2rem;
  }
  /* Wide tables scroll inside their own box rather than pushing the page
     sideways. The wrapper is what scrolls; the table keeps its own width. */
  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
    /* The page paints a fixed engineering grid behind everything, and a
       translucent cell lets it show through as phantom column rules. Give
       the table its own opaque ground so rows read as rows. */
    background: var(--color-surface-solid);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }
  .prose th,
  .prose td {
    border: 1px solid var(--color-line);
    padding: 0.6rem 0.8rem;
    text-align: left;
  }
  .prose th {
    background: color-mix(in srgb, var(--color-accent) 7%, var(--color-surface-solid));
    font-family: var(--font-display);
  }
  .prose tbody tr:nth-child(even) td {
    background: color-mix(in srgb, var(--color-bg) 55%, var(--color-surface-solid));
  }
</style>
