---
import { Icon } from "astro-icon/components";
import ServiceIllustration from "@components/ServiceIllustration.astro";
import type { Pillar } from "@data/services";

interface Props {
  pillar: Pillar;
  index?: number;
}
const { pillar, index } = Astro.props;
---

<a
  href={pillar.href}
  class="service-card tilt"
  data-tilt="4"
  data-reveal="3d"
  data-delay={index === undefined ? undefined : String(Math.min(index + 1, 6))}
  style={`--pillar:${pillar.accent}`}
>
  <div class="card-illus">
    <ServiceIllustration slug={pillar.slug} />
    {index !== undefined && <span class="card-num">{String(index + 1).padStart(2, "0")}</span>}
  </div>
  <div class="card-body">
    <h3 class="card-title">{pillar.title}</h3>
    <p class="card-outcome">{pillar.outcome}</p>
    <span class="card-cta">
      Explore
      <Icon name="lucide:arrow-right" />
    </span>
  </div>
</a>

<style>
  /* The card is the tilting object, so the transform belongs to .tilt and
     this rule must not set one of its own. Depth is expressed instead by
     the shadow deepening as the card lifts — the illustration is clipped
     to the card, so overflow has to stay hidden and children can't ride
     out on the Z axis. */
  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background:
      linear-gradient(
        158deg,
        rgba(255, 255, 255, 0.62),
        rgba(255, 255, 255, 0.12) 46%,
        rgba(255, 255, 255, 0.42)
      ),
      var(--color-surface);
    border: 1px solid var(--glass-edge);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-soft);
    transition:
      transform 0.5s var(--ease-glide),
      box-shadow 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out);
  }
  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .service-card {
      -webkit-backdrop-filter: blur(var(--glass-blur-sm)) saturate(var(--glass-saturate));
      backdrop-filter: blur(var(--glass-blur-sm)) saturate(var(--glass-saturate));
    }
  }
  /* Pointer-tracked hotspot in the pillar's own colour, so each card
     lights in its own hue as the cursor crosses it. */
  .service-card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-card);
    background: radial-gradient(
      60% 60% at var(--mx) var(--my),
      color-mix(in srgb, var(--pillar) 18%, transparent),
      transparent 62%
    );
    opacity: 0;
    transition: opacity 0.35s var(--ease-out);
    pointer-events: none;
  }
  .service-card:hover {
    box-shadow: var(--shadow-float);
    border-color: color-mix(in srgb, var(--pillar) 55%, var(--glass-edge));
  }
  .service-card:hover::after {
    opacity: 1;
  }

  .card-illus {
    position: relative;
    padding: 0.6rem 0.6rem 0;
  }
  .card-num {
    position: absolute;
    top: 1.1rem;
    right: 1.2rem;
    z-index: 2;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.82rem;
    /* The badge sits on a dark scrim over the illustration, so the number
       has to be lightened toward white — mixing toward ink (correct on a
       light card face) would put dark text on a dark plate. */
    color: color-mix(in srgb, var(--pillar, var(--color-accent)) 55%, #ffffff);
    background: rgba(10, 19, 34, 0.62);
    padding: 0.15rem 0.45rem;
    border-radius: 6px;
    backdrop-filter: blur(2px);
  }

  .card-body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: 1.3rem 1.5rem 1.5rem;
  }
  .card-title {
    font-size: 1.2rem;
  }
  .card-outcome {
    margin-top: 0.5rem;
    color: var(--color-muted);
    line-height: 1.55;
    flex-grow: 1;
  }
  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.9rem;
    /* 75% of a raw pillar accent — amber worst of all — lands under 3:1
       on the light card face. 55% keeps the pillar's identity while
       clearing AA for body-sized text. */
    color: color-mix(in srgb, var(--pillar) 55%, var(--color-ink));
  }
  .card-cta svg {
    width: 1rem;
    height: 1rem;
    transition: transform 0.2s var(--ease-out);
  }
  .service-card:hover .card-cta svg {
    transform: translateX(4px);
  }
</style>
